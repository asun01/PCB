<Window x:Class="Asun.App.Shell.Bootstrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asun Vision Platform"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="Asun.App.Shell.MainWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                AutomationProperties.AutomationId="Shell.Title"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Asun Vision Platform" />
            <TextBlock
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="Shell.Subtitle"
                FontSize="14"
                Opacity="0.72"
                Text="Client shell · .NET 10 · WPF" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,24,0,0"
            Padding="16"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    AutomationProperties.AutomationId="Shell.StatusLabel"
                    FontWeight="SemiBold"
                    Text="Client workspace" />
                <TextBlock
                    x:Name="WorkspaceStatus"
                    Margin="0,6,0,0"
                    AutomationProperties.AutomationId="Shell.WorkspaceStatus"
                    Text="Idle — no production session loaded." />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,16,0,0"
            Padding="16"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Deterministic simulation" />
                <TextBlock
                    Margin="0,4,0,12"
                    Opacity="0.72"
                    Text="Development-only path. It uses the vendor-neutral Production Runtime with a deterministic simulated frame source; it does not claim hardware or HALCON execution." />
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="RunSimulationButton"
                        Width="180"
                        Height="32"
                        Click="RunSimulationButton_Click"
                        Content="Run Simulation"
                        AutomationProperties.AutomationId="Shell.RunSimulation" />
                    <TextBlock
                        x:Name="SimulationStatus"
                        Margin="16,7,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Shell.SimulationStatus"
                        Text="Ready." />
                    <TextBlock
                        x:Name="ReleaseStatus"
                        Margin="16,7,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Shell.ReleaseStatus"
                        Text="Release: not evaluated." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Padding="20"
            BorderThickness="1"
            AutomationProperties.AutomationId="Shell.ContentHost">
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Workspace host" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    MaxWidth="760"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Opacity="0.72"
                    Text="Production commands enter through the vendor-neutral Client Integration boundary. Hardware, HALCON, and DevExpress authority remain isolated behind their recorded environment gates." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
