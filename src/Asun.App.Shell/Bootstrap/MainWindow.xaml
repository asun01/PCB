<Window x:Class="Asun.App.Shell.Bootstrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asun Vision Platform"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="Asun.App.Shell.MainWindow"
        Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                AutomationProperties.AutomationId="Shell.Title"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Asun Vision Platform" />
            <TextBlock
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="Shell.Subtitle"
                FontSize="14"
                Opacity="0.72"
                Text="Client shell · .NET 10 · WPF" />
            <StackPanel
                Margin="0,16,0,0"
                Orientation="Horizontal"
                AutomationProperties.AutomationId="Shell.WorkspaceNavigation">
                <Button
                    Width="90"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="WorkspaceHomeButton_Click"
                    Content="Home"
                    AutomationProperties.AutomationId="Shell.WorkspaceHome" />
                <Button
                    Width="100"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="WorkspaceInspectionButton_Click"
                    Content="Inspection"
                    AutomationProperties.AutomationId="Shell.WorkspaceInspection" />
                <Button
                    Width="90"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="WorkspaceProgramButton_Click"
                    Content="Program"
                    AutomationProperties.AutomationId="Shell.WorkspaceProgram" />
                <Button
                    Width="90"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="WorkspaceQualityButton_Click"
                    Content="Quality"
                    AutomationProperties.AutomationId="Shell.WorkspaceQuality" />
                <Button
                    Width="90"
                    Height="30"
                    Click="WorkspaceResultsButton_Click"
                    Content="Results"
                    AutomationProperties.AutomationId="Shell.WorkspaceResults" />
                <TextBlock
                    x:Name="WorkspaceNavigationStatus"
                    Margin="16,7,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Shell.WorkspaceNavigationStatus"
                    Text="Workspace: Home" />
            </StackPanel>

        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,24,0,0"
            Padding="16"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    AutomationProperties.AutomationId="Shell.StatusLabel"
                    FontWeight="SemiBold"
                    Text="Client workspace" />
                <TextBlock
                    x:Name="WorkspaceStatus"
                    Margin="0,6,0,0"
                    AutomationProperties.AutomationId="Shell.WorkspaceStatus"
                    Text="Idle — no production session loaded." />
                <TextBlock
                    x:Name="ProgramStatus"
                    Margin="0,6,0,0"
                    AutomationProperties.AutomationId="Shell.ProgramStatus"
                    Text="Program: none loaded." />
                <ProgressBar
                    x:Name="ExecutionProgress"
                    Margin="0,8,0,0"
                    Height="8"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    AutomationProperties.AutomationId="Shell.ExecutionProgress" />
                <TextBlock
                    x:Name="AcquisitionStatus"
                    Margin="0,6,0,0"
                    AutomationProperties.AutomationId="Shell.AcquisitionStatus"
                    Text="Acquisition: unbound." />
                <StackPanel
                    Margin="0,6,0,0"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Source:" />
                    <ComboBox
                        x:Name="AcquisitionSourceComboBox"
                        Width="240"
                        Margin="8,0,0,0"
                        DisplayMemberPath="Descriptor.DisplayName"
                        AutomationProperties.AutomationId="Shell.AcquisitionSource" />
                    <Button
                        x:Name="BindAcquisitionButton"
                        Width="110"
                        Margin="8,0,0,0"
                        Click="BindAcquisitionButton_Click"
                        Content="Bind Source"
                        AutomationProperties.AutomationId="Shell.BindAcquisition" />
                    <Button
                        x:Name="PreviewAcquisitionButton"
                        Width="100"
                        Margin="8,0,0,0"
                        Click="PreviewAcquisitionButton_Click"
                        Content="Preview"
                        AutomationProperties.AutomationId="Shell.PreviewAcquisition" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,16,0,0"
            Padding="16"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Deterministic simulation" />
                <TextBlock
                    Margin="0,4,0,12"
                    Opacity="0.72"
                    Text="Development-only path. It uses the vendor-neutral Production Runtime with a deterministic simulated frame source; it does not claim hardware or HALCON execution." />
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="SelectRoiButton"
                        Width="100"
                        Height="32"
                        Click="SelectRoiButton_Click"
                        Content="Select ROI"
                        AutomationProperties.AutomationId="Shell.SelectRoi" />
                    <Button
                        x:Name="CreateRoiButton"
                        Margin="8,0,0,0"
                        Width="100"
                        Height="32"
                        Click="CreateRoiButton_Click"
                        Content="Create ROI"
                        AutomationProperties.AutomationId="Shell.CreateRoi" />
                    <Button
                        x:Name="UndoRoiButton"
                        Margin="8,0,0,0"
                        Width="90"
                        Height="32"
                        Click="UndoRoiButton_Click"
                        Content="Undo ROI"
                        AutomationProperties.AutomationId="Shell.UndoRoi" />
                    <Button
                        x:Name="RedoRoiButton"
                        Margin="8,0,0,0"
                        Width="90"
                        Height="32"
                        Click="RedoRoiButton_Click"
                        Content="Redo ROI"
                        AutomationProperties.AutomationId="Shell.RedoRoi" />
                    <Button
                        x:Name="LoadSimulationButton"
                        Margin="8,0,0,0"
                        Width="150"
                        Height="32"
                        Click="LoadSimulationButton_Click"
                        Content="Load Simulation"
                        AutomationProperties.AutomationId="Shell.LoadSimulation" />
                    <Button
                        x:Name="RunSimulationButton"
                        Margin="8,0,0,0"
                        Width="150"
                        Height="32"
                        Click="RunSimulationButton_Click"
                        Content="Run Simulation"
                        AutomationProperties.AutomationId="Shell.RunSimulation" />
                    <Button
                        x:Name="CancelSimulationButton"
                        Margin="8,0,0,0"
                        Width="110"
                        Height="32"
                        Click="CancelSimulationButton_Click"
                        Content="Cancel"
                        IsEnabled="False"
                        AutomationProperties.AutomationId="Shell.CancelSimulation" />
                    <Button
                        x:Name="ResetSessionButton"
                        Margin="8,0,0,0"
                        Width="130"
                        Height="32"
                        Click="ResetSessionButton_Click"
                        Content="Reset Session"
                        AutomationProperties.AutomationId="Shell.ResetSession" />
                    <TextBlock
                        x:Name="SimulationStatus"
                        Margin="16,7,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Shell.SimulationStatus"
                        Text="Ready." />
                    <TextBlock
                        x:Name="ReleaseStatus"
                        Margin="16,7,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Shell.ReleaseStatus"
                        Text="Release: not evaluated." />
                    <TextBlock
                        x:Name="RunHistoryStatus"
                        Margin="16,7,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Shell.RunHistoryStatus"
                        Text="History: 0 runs." />
                    <TextBlock
                        x:Name="DiagnosticStatus"
                        Margin="16,7,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Shell.DiagnosticStatus"
                        Text="Diagnostic: not evaluated." />
                    <ListBox
                        x:Name="RunHistoryList"
                        Margin="0,8,0,0"
                        Height="92"
                        SelectionChanged="RunHistoryList_SelectionChanged"
                        AutomationProperties.AutomationId="Shell.RunHistoryList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="42" Text="{Binding Ordinal}" />
                                    <TextBlock Width="250" Text="{Binding SessionText}" />
                                    <TextBlock Width="92" Text="{Binding FrameText}" />
                                    <TextBlock Width="220" Text="{Binding ReleaseText}" />
                                    <TextBlock Text="{Binding ReplayText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Padding="12"
            BorderThickness="1"
            AutomationProperties.AutomationId="Shell.ContentHost">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.ColumnSpan="2"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Client workspace content" />
                <Border
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,12,8,8"
                    Padding="20"
                    BorderThickness="1"
                    x:Name="HomeWorkspace"
                    AutomationProperties.AutomationId="Shell.HomeWorkspace">
                    <StackPanel>
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="Inspection Client Overview" />
                        <TextBlock
                            x:Name="HomeProgramStatus"
                            Margin="0,12,0,0"
                            Text="Program: not loaded." />
                        <TextBlock
                            x:Name="HomeAcquisitionStatus"
                            Margin="0,6,0,0"
                            Text="Acquisition: not bound." />
                        <TextBlock
                            x:Name="HomeProductionStatus"
                            Margin="0,6,0,0"
                            Text="Production: idle." />
                        <TextBlock
                            x:Name="HomeQualityStatus"
                            Margin="0,6,0,0"
                            Text="Quality: not attached." />
                        <TextBlock
                            x:Name="HomeResultsStatus"
                            Margin="0,6,0,0"
                            Text="Results: no history." />
                        <TextBlock
                            x:Name="HomeWorkflowStatus"
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"
                            Text="Workflow: Load Program." />
                        <TextBlock
                            x:Name="HomeWorkflowMessage"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap"
                            Text="Load a valid inspection Program." />
                        <TextBlock
                            x:Name="HomeFingerprint"
                            Margin="0,12,0,0"
                            Opacity="0.65"
                            Text="Overview fingerprint unavailable." />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Margin="0,12,8,8"
                    Padding="12"
                    BorderThickness="1"
                    x:Name="ProgramWorkspace"
                    AutomationProperties.AutomationId="Shell.ProgramWorkspace">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Program steps" />
                        <ListBox
                            x:Name="ProgramStepList"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            SelectionChanged="ProgramStepList_SelectionChanged"
                            AutomationProperties.AutomationId="Shell.ProgramStepList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="44" Text="{Binding Order}" />
                                        <TextBlock Width="180" Text="{Binding Name}" />
                                        <TextBlock Width="110" Text="{Binding Kind}" />
                                        <TextBlock Text="{Binding ParameterCount}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock
                            x:Name="ProgramStepDetails"
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            AutomationProperties.AutomationId="Shell.ProgramStepDetails"
                            Text="No Program step selected." />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="8,12,0,8"
                    Padding="12"
                    BorderThickness="1"
                    x:Name="ResultWorkspace"
                    AutomationProperties.AutomationId="Shell.ResultWorkspace">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Inspection result" />
                        <TextBlock x:Name="ResultStatus" Margin="0,8,0,0" Text="Idle" />
                        <TextBlock x:Name="ResultSession" Margin="0,4,0,0" Text="Session not loaded" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultReplay" Margin="0,4,0,0" Text="Replay not available" />
                        <TextBlock x:Name="ResultRelease" Margin="0,4,0,0" Text="Release not evaluated" TextWrapping="Wrap" />
                        <Separator Margin="0,12,0,8" />
                        <TextBlock FontWeight="SemiBold" Text="Quality workspace" />
                        <TextBlock
                            x:Name="QualityStatus"
                            Margin="0,6,0,0"
                            Text="Quality Run: not attached. No Quality authority is being fabricated by the client shell."
                            TextWrapping="Wrap" />
                        <ListBox
                            x:Name="QualityFindingList"
                            Margin="0,8,0,0"
                            Height="100"
                            SelectionChanged="QualityFindingList_SelectionChanged"
                            AutomationProperties.AutomationId="Shell.QualityFindingList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="80" Text="{Binding Outcome}" />
                                        <TextBlock Width="90" Text="{Binding Severity}" />
                                        <TextBlock Width="100" Text="{Binding RuleCode}" />
                                        <TextBlock Text="{Binding Message}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock
                            x:Name="QualityFindingDetails"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            Text="No Quality finding selected." />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,8"
                    Padding="12"
                    BorderThickness="1">
                    <Grid>
                        <Border
                            x:Name="QualityWorkspaceOverlay"
                            Background="{x:Null}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="RoiWorkspaceTitle"
                            FontWeight="SemiBold"
                            Text="ROI interaction host" />
                        <Image
                            x:Name="FramePreviewImage"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="620"
                            MaxHeight="360"
                            AutomationProperties.AutomationId="Shell.FramePreviewImage" />
                        <Canvas
                            x:Name="RoiSurface"
                            Margin="0,28,0,24"
                            Focusable="True"
                            SizeChanged="RoiSurface_SizeChanged"
                            MouseDown="RoiSurface_MouseDown"
                            MouseMove="RoiSurface_MouseMove"
                            MouseUp="RoiSurface_MouseUp"
                            MouseWheel="RoiSurface_MouseWheel"
                            KeyDown="RoiSurface_KeyDown">
                            <TextBlock
                                x:Name="RoiSurfaceHint"
                                Margin="16"
                                Opacity="0.65"
                                Text="Run the deterministic simulation, then choose Create ROI and drag on this vendor-neutral WPF development surface." />
                        </Canvas>
                        <TextBlock
                            x:Name="RoiStatus"
                            Margin="0,0,0,0"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="Shell.RoiStatus"
                            Text="ROI: workspace not bound." />
                    </Grid>
                </Border>            </Grid>
        </Border>
    </Grid>
</Window>
